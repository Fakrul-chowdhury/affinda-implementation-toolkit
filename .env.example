# Copy to .env (git-ignored) and fill in. Never commit a real key.
AFFINDA_API_KEY=aff_your_key_here
# Workspace and document type identifiers from the Affinda dashboard (or the API).
AFFINDA_WORKSPACE_ID=your_workspace_id
AFFINDA_DOCUMENT_TYPE_ID=your_document_type_id
# mock = replay recorded responses (free, UAT documents only) | live = call Affinda (1 credit per page)
EXTRACTOR_MODE=mock
